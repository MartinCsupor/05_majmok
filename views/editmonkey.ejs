<%- include('header') %>
    <main class="mx-auto max-w-2xl px-5 py-10 sm:py-14">
        <div class="mb-7 border-l-4 border-amber-400 pl-4">
            <h1 class="text-3xl font-bold text-emerald-950">Majom szerkesztése</h1>
            <p class="mt-2 text-sm text-stone-600">
                <%= monkey.name %> adatainak szerkesztése
            </p>
        </div>

        <form method="post" class="space-y-5 rounded-lg border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
            <div>
                <label for="name" class="mb-1.5 block text-sm font-semibold text-stone-700">Név</label>
                <input id="name" name="name" type="text" value="<%= monkey.name %>" required
                    class="w-full rounded-md border border-stone-300 px-3 py-2.5 text-stone-900 outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/20">
            </div>
            <div>
                <label for="sex" class="mb-1.5 block text-sm font-semibold text-stone-700">Nem</label>
                <select id="sex" name="sex" required
                    class="w-full rounded-md border border-stone-300 bg-white px-3 py-2.5 text-stone-900 outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/20">
                    <option value="male" <%=monkey.sex==='male' ? 'selected' : '' %>>Férfi</option>
                    <option value="female" <%=monkey.sex==='female' ? 'selected' : '' %>>Nő</option>
                </select>
            </div>
            <div>
                <label for="species" class="mb-1.5 block text-sm font-semibold text-stone-700">Faj</label>
                <input id="species" name="species" type="text" value="<%= monkey.species %>" required
                    class="w-full rounded-md border border-stone-300 px-3 py-2.5 text-stone-900 outline-none focus:border-emerald-700 focus:ring-2 focus:ring-emerald-700/20">
            </div>
            <div class="flex flex-wrap justify-end gap-3 border-t border-stone-100 pt-5">
                <a href="/monkeys"
                    class="rounded-md px-4 py-2.5 text-sm font-semibold text-stone-600 no-underline hover:bg-stone-100">Mégse</a>
                <button type="submit"
                    class="rounded-md bg-emerald-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800">Mentés</button>
            </div>
        </form>
    </main>
    <%- include('footer') %>